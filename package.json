{
  "name": "@eleansphere/entity-core",
  "version": "3.0.0",
  "description": "Client-side toolkit for be-core apps: define an entity once (fields + validation) and derive its ModelConfig, DTO classes, and HTTP service; plus the ApiClient / abstract service layer and container/model-config wiring helpers.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Eleansphere/entity-core.git"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "format": "prettier --write src/",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "release": "npm run build && changeset publish"
  },
  "keywords": [],
  "author": "Eleansphere",
  "license": "ISC",
  "dependencies": {
    "@eleansphere/be-core": "^1.12.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.6",
    "typescript": "^5.4.5"
  }
}
